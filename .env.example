# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pixelplay
AUTH_SESSION_COOKIE=pixelplay_session
AUTH_SESSION_TTL_DAYS=30
# Production must provide a shared rate-limit adapter. "memory" is development-only.
# RATE_LIMIT_STORE=memory
# Set to 1 only when the deployment proxy sanitizes forwarded client IP headers.
TRUST_PROXY_HEADERS=0

# Mail.ru SMTP (SMTP_PASSWORD is the Mail.ru app password with SMTP send-only access)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=